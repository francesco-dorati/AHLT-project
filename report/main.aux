\@writefile{lot}{\contentsline {table}{\numberline {19}{\ignorespaces Final test-set evaluation (\texttt  {prompts01}, 4-bit quant). \textbf  {Best system: Llama + $r=32$}. It wins on every test metric (micro, macro, span-F1), reverses the devel-set macro order (Qwen was winning devel macro by 1.2\,pp), and is within 3.1\,pp of few-shot's devel--test generalisation gap.}}{34}{table.caption.59}\protected@file@percent }
\newlabel{tab:13-test}{{19}{34}{Final test-set evaluation (\texttt {prompts01}, 4-bit quant). \textbf {Best system: Llama + $r=32$}. It wins on every test metric (micro, macro, span-F1), reverses the devel-set macro order (Qwen was winning devel macro by 1.2\,pp), and is within 3.1\,pp of few-shot's devel--test generalisation gap}{table.caption.59}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {28}{\ignorespaces Test-set per-class F1 (coloured bars) with micro-F1 (white circles) for the four systems we ran on test. The pink highlight marks the winning system (Llama+$r=32$); note that Qwen+$r=32$ still wins \textit  {brand} (75.0\,\%) and could be preferred if \textit  {brand} were the primary metric.}}{34}{figure.caption.60}\protected@file@percent }
\newlabel{fig:13-testbars}{{28}{34}{Test-set per-class F1 (coloured bars) with micro-F1 (white circles) for the four systems we ran on test. The pink highlight marks the winning system (Llama+$r=32$); note that Qwen+$r=32$ still wins \textit {brand} (75.0\,\%) and could be preferred if \textit {brand} were the primary metric}{figure.caption.60}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {29}{\ignorespaces Devel~$\to $~test generalisation gap. Few-shot's gap is 3.0\,pp; the Phase-D fine-tune's gap is 2.7\,pp; $r=32$'s gap is 4.9\,pp; Qwen+$r=32$'s gap is 4.6\,pp. The larger adapter overfits devel slightly more, but not enough to lose its test-set lead.}}{35}{figure.caption.61}\protected@file@percent }
\newlabel{fig:13-gap}{{29}{35}{Devel~$\to $~test generalisation gap. Few-shot's gap is 3.0\,pp; the Phase-D fine-tune's gap is 2.7\,pp; $r=32$'s gap is 4.9\,pp; Qwen+$r=32$'s gap is 4.6\,pp. The larger adapter overfits devel slightly more, but not enough to lose its test-set lead}{figure.caption.61}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {30}{\ignorespaces Per-class devel F1 for the best few-shot (\texttt  {prompts03/15}) vs the best fine-tune (Llama $r=32$). Same base model, same 4-bit quant, same prompt framing; the only difference is ten epochs of LoRA training on the DDI training set.}}{35}{figure.caption.62}\protected@file@percent }
\newlabel{fig:13-fs-vs-ft-pc}{{30}{35}{Per-class devel F1 for the best few-shot (\texttt {prompts03/15}) vs the best fine-tune (Llama $r=32$). Same base model, same 4-bit quant, same prompt framing; the only difference is ten epochs of LoRA training on the DDI training set}{figure.caption.62}{}}
