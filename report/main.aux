\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces LoRA rank vs training epochs (Llama, 4-bit, \texttt  {prompts01}). Quadrupling rank ($r=8\to r=32$, $\alpha =16\to \alpha =64$) lifts micro-F1 by \textbf  {+4.1\,pp} and macro-F1 by \textbf  {+8.1\,pp} over the Phase-D baseline. Adding five more training epochs (15 vs 10) lifts micro-F1 by only +1.8\,pp. Rank capacity matters more than training time.}}{29}{figure.caption.46}\protected@file@percent }
\newlabel{fig:13-rank}{{22}{29}{LoRA rank vs training epochs (Llama, 4-bit, \texttt {prompts01}). Quadrupling rank ($r=8\to r=32$, $\alpha =16\to \alpha =64$) lifts micro-F1 by \textbf {+4.1\,pp} and macro-F1 by \textbf {+8.1\,pp} over the Phase-D baseline. Adding five more training epochs (15 vs 10) lifts micro-F1 by only +1.8\,pp. Rank capacity matters more than training time}{figure.caption.46}{}}
