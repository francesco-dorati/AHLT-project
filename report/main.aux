\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Headline test-set results across the three systems}{37}{subsection.6.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {31}{\ignorespaces Cross-system headline comparison on the DDI test set. Left: micro-F1 (m.avg). Right: macro-F1 (M.avg). The best System~1.3 system (FT Llama $r=32$) trails System~1.2 by $-$28.5\,pp on micro and $-$13.4\,pp on macro. The gap is \emph  {smaller on macro} --- the LLM is comparatively more competitive on the harder classes than on the easy ones.}}{37}{figure.caption.63}\protected@file@percent }
\newlabel{fig:conc-cross}{{31}{37}{Cross-system headline comparison on the DDI test set. Left: micro-F1 (m.avg). Right: macro-F1 (M.avg). The best System~1.3 system (FT Llama $r=32$) trails System~1.2 by $-$28.5\,pp on micro and $-$13.4\,pp on macro. The gap is \emph {smaller on macro} --- the LLM is comparatively more competitive on the harder classes than on the easy ones}{figure.caption.63}{}}
\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces Test-set F1 comparison across the three systems (all values in \%; best in each column highlighted). Configurations: CRF mod8 ($c_1{=}c_2{=}0.1$); BiLSTM \texttt  {champ\_big\_s42}; LLM Llama $r{=}32$, 10\,ep, 4-bit. CRF/BiLSTM dominate on micro, macro, and the common classes; the LLM only wins \textit  {drug\_n} but does so by 26--29\,pp.}}{37}{table.caption.64}\protected@file@percent }
\newlabel{tab:conc}{{20}{37}{Test-set F1 comparison across the three systems (all values in \%; best in each column highlighted). Configurations: CRF mod8 ($c_1{=}c_2{=}0.1$); BiLSTM \texttt {champ\_big\_s42}; LLM Llama $r{=}32$, 10\,ep, 4-bit. CRF/BiLSTM dominate on micro, macro, and the common classes; the LLM only wins \textit {drug\_n} but does so by 26--29\,pp}{table.caption.64}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {32}{\ignorespaces Per-class test F1 across the three systems. The LLM only wins one column (\textit  {drug\_n}, the rare class) but does so by a very large margin. On the three common classes, the CRF's sharp character-level patterns and the BiLSTM's learned embeddings dominate by 20--30\,pp.}}{38}{figure.caption.65}\protected@file@percent }
\newlabel{fig:13-cross-pc}{{32}{38}{Per-class test F1 across the three systems. The LLM only wins one column (\textit {drug\_n}, the rare class) but does so by a very large margin. On the three common classes, the CRF's sharp character-level patterns and the BiLSTM's learned embeddings dominate by 20--30\,pp}{figure.caption.65}{}}
