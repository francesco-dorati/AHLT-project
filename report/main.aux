\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces Round-5 devel+test matrix. \texttt  {champ\_big} is the first config with a \emph  {robust} test advantage.}}{19}{table.caption.29}\protected@file@percent }
