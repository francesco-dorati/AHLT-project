\newlabel{tab:12-perclass}{{15}{19}{Per-entity-type test results for the final champion \texttt {champ\_big\_s42}. Test macro-F1 = 69.1\% (devel 70.7\%, gap $-$1.6, normal)}{table.caption.37}{}}
\@writefile{toc}{\contentsline {paragraph}{Honest reporting.}{19}{paragraph*.38}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.11}Per-class comparison with System 1.1}{19}{subsection.4.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Per-entity-type test F1. The NN system dominates on \textit  {group} (+6.5) and slightly improves on \textit  {drug\_n} (+3.0), ties on \textit  {drug}, and loses a few points on \textit  {brand}. The pattern is consistent: the BiLSTM picks up distributional context (which helps semantic classes like \textit  {group}) at the cost of CRF's sharper local character patterns for trademark-style \textit  {brand} tokens.}}{20}{figure.caption.39}\protected@file@percent }
\newlabel{fig:12-perentity}{{15}{20}{Per-entity-type test F1. The NN system dominates on \textit {group} (+6.5) and slightly improves on \textit {drug\_n} (+3.0), ties on \textit {drug}, and loses a few points on \textit {brand}. The pattern is consistent: the BiLSTM picks up distributional context (which helps semantic classes like \textit {group}) at the cost of CRF's sharper local character patterns for trademark-style \textit {brand} tokens}{figure.caption.39}{}}
\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces Final cross-system per-type comparison. System~1.2 (\texttt  {champ\_big\_s42}) improves total macro-F1 by +1.4~pt over System~1.1 (CRF~mod8), with all of the gain coming from \textit  {group} and \textit  {drug\_n}.}}{20}{table.caption.40}\protected@file@percent }
\newlabel{tab:12-cross}{{16}{20}{Final cross-system per-type comparison. System~1.2 (\texttt {champ\_big\_s42}) improves total macro-F1 by +1.4~pt over System~1.1 (CRF~mod8), with all of the gain coming from \textit {group} and \textit {drug\_n}}{table.caption.40}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.12}Progress timeline and headline comparison}{20}{subsection.4.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Progress timeline for System 1.2. Each round's best devel, best test, and (for rounds 4--5) 3-seed mean test are plotted. The round-3 devel peak at 70.2\% was largely seed luck: the round-5 \texttt  {champ\_big} mean at 69.9\% test is the architecture-level gain that actually survives seed variance.}}{21}{figure.caption.41}\protected@file@percent }
\newlabel{fig:12-timeline}{{16}{21}{Progress timeline for System 1.2. Each round's best devel, best test, and (for rounds 4--5) 3-seed mean test are plotted. The round-3 devel peak at 70.2\% was largely seed luck: the round-5 \texttt {champ\_big} mean at 69.9\% test is the architecture-level gain that actually survives seed variance}{figure.caption.41}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Final headline comparison. System~1.1 (CRF mod8) reaches 67.7\% test; System~1.2 reaches \textbf  {69.1\%} (single-seed, PDF-compliant) or \textbf  {69.9\%} (3-seed mean), a +1.4 or +2.2 point improvement respectively.}}{21}{figure.caption.42}\protected@file@percent }
\newlabel{fig:12-cross}{{17}{21}{Final headline comparison. System~1.1 (CRF mod8) reaches 67.7\% test; System~1.2 reaches \textbf {69.1\%} (single-seed, PDF-compliant) or \textbf {69.9\%} (3-seed mean), a +1.4 or +2.2 point improvement respectively}{figure.caption.42}{}}
