\@writefile{toc}{\contentsline {subsection}{\numberline {4.11}Per-class comparison with System 1.1}{21}{subsection.4.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Per-entity-type test F1. The NN system dominates on \textit  {group} (+6.5) and slightly improves on \textit  {drug\_n} (+3.0), ties on \textit  {drug}, and loses a few points on \textit  {brand}. The pattern is consistent: the BiLSTM picks up distributional context (which helps semantic classes like \textit  {group}) at the cost of CRF's sharper local character patterns for trademark-style \textit  {brand} tokens.}}{22}{figure.caption.34}\protected@file@percent }
\newlabel{fig:12-perentity}{{15}{22}{Per-entity-type test F1. The NN system dominates on \textit {group} (+6.5) and slightly improves on \textit {drug\_n} (+3.0), ties on \textit {drug}, and loses a few points on \textit {brand}. The pattern is consistent: the BiLSTM picks up distributional context (which helps semantic classes like \textit {group}) at the cost of CRF's sharper local character patterns for trademark-style \textit {brand} tokens}{figure.caption.34}{}}
\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces Final cross-system per-type comparison. System~1.2 (\texttt  {champ\_big\_s42}) improves total macro-F1 by +1.4~pt over System~1.1 (CRF~mod8), with all of the gain coming from \textit  {group} and \textit  {drug\_n}.}}{22}{table.caption.35}\protected@file@percent }
\newlabel{tab:12-cross}{{16}{22}{Final cross-system per-type comparison. System~1.2 (\texttt {champ\_big\_s42}) improves total macro-F1 by +1.4~pt over System~1.1 (CRF~mod8), with all of the gain coming from \textit {group} and \textit {drug\_n}}{table.caption.35}{}}
