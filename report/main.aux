\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Few-shot $k$-sweep (Llama~3.2~3B~Instruct, \texttt  {prompts01}, 4-bit quant). Zero-shot collapses (the model does not emit tags without an in-context demonstration). Gains saturate above $k=5$; span-F1 (no class) is consistently $\sim $8~pp above micro-F1, meaning the model is better at locating entity boundaries than at classifying them.}}{26}{figure.caption.42}\protected@file@percent }
\newlabel{fig:13-shots}{{19}{26}{Few-shot $k$-sweep (Llama~3.2~3B~Instruct, \texttt {prompts01}, 4-bit quant). Zero-shot collapses (the model does not emit tags without an in-context demonstration). Gains saturate above $k=5$; span-F1 (no class) is consistently $\sim $8~pp above micro-F1, meaning the model is better at locating entity boundaries than at classifying them}{figure.caption.42}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Prompt~$\times $~shots ablation. Left: micro-F1. Right: macro-F1. The refined prompts (\texttt  {prompts02}, \texttt  {prompts03}) trade macro for micro --- the best micro (prompts03/15 = 40.9\%) has the \emph  {worst} macro (26.6\%) because \textit  {drug\_n} recall goes to zero. For a rare-class-sensitive task, \texttt  {prompts01/15} (macro 32.8\%) is the saner default.}}{26}{figure.caption.43}\protected@file@percent }
\newlabel{fig:13-prompts}{{20}{26}{Prompt~$\times $~shots ablation. Left: micro-F1. Right: macro-F1. The refined prompts (\texttt {prompts02}, \texttt {prompts03}) trade macro for micro --- the best micro (prompts03/15 = 40.9\%) has the \emph {worst} macro (26.6\%) because \textit {drug\_n} recall goes to zero. For a rare-class-sensitive task, \texttt {prompts01/15} (macro 32.8\%) is the saner default}{figure.caption.43}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Per-class devel F1 under four flagship few-shot configurations. \textit  {brand} and \textit  {drug} are learnable from 5--15 demonstrations; \textit  {drug\_n} is not. Only the class-balanced sampler (last group) lifts \textit  {drug\_n} above zero, at a 6\,pp cost on micro-F1.}}{27}{figure.caption.44}\protected@file@percent }
\newlabel{fig:13-pc-fs}{{21}{27}{Per-class devel F1 under four flagship few-shot configurations. \textit {brand} and \textit {drug} are learnable from 5--15 demonstrations; \textit {drug\_n} is not. Only the class-balanced sampler (last group) lifts \textit {drug\_n} above zero, at a 6\,pp cost on micro-F1}{figure.caption.44}{}}
\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces Few-shot devel results (\textit  {Llama 3.2 3B Instruct} + 4-bit quant unless labelled \textit  {Qwen}). All F1 in \%. \textbf  {Best micro: p03/15 = 40.9\%}. \textbf  {Best macro: balanced sampler = 32.5\%}. The two optima disagree because prompts03 zeros out \textit  {drug\_n}.}}{27}{table.caption.45}\protected@file@percent }
\newlabel{tab:13-fewshot}{{17}{27}{Few-shot devel results (\textit {Llama 3.2 3B Instruct} + 4-bit quant unless labelled \textit {Qwen}). All F1 in \%. \textbf {Best micro: p03/15 = 40.9\%}. \textbf {Best macro: balanced sampler = 32.5\%}. The two optima disagree because prompts03 zeros out \textit {drug\_n}}{table.caption.45}{}}
