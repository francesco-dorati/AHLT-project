\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Pretrained word embeddings on the lower-cased-word channel. Fine-tuning destroys the pretrained structure ($-$2.3 vs.\ random); freezing partially recovers (+5.5); stacking pretrained vectors on top of \texttt  {final04} drops macro-F1 by \textbf  {$-$5.7}. spaCy \texttt  {md} is trained on generic news text and carries the wrong priors for drug names.}}{16}{figure.caption.18}\protected@file@percent }
\newlabel{fig:12-pretrained}{{11}{16}{Pretrained word embeddings on the lower-cased-word channel. Fine-tuning destroys the pretrained structure ($-$2.3 vs.\^^Mrandom); freezing partially recovers (+5.5); stacking pretrained vectors on top of \texttt {final04} drops macro-F1 by \textbf {$-$5.7}. spaCy \texttt {md} is trained on generic news text and carries the wrong priors for drug names}{figure.caption.18}{}}
