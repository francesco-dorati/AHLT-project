\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Round-1 combo results. Stacking \texttt  {pos} + \texttt  {pref} + \texttt  {layernorm} + \texttt  {gelu} + heavy embedding dropout (\texttt  {final04}) is the best 8-epoch devel config. Adding a second stacked LSTM layer (\texttt  {final05}) slightly hurts: the model is under-trained, not under-parameterised.}}{12}{figure.caption.21}\protected@file@percent }
\newlabel{fig:12-combos}{{9}{12}{Round-1 combo results. Stacking \texttt {pos} + \texttt {pref} + \texttt {layernorm} + \texttt {gelu} + heavy embedding dropout (\texttt {final04}) is the best 8-epoch devel config. Adding a second stacked LSTM layer (\texttt {final05}) slightly hurts: the model is under-trained, not under-parameterised}{figure.caption.21}{}}
